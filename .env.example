# palimpsest-stack — environment
#
# Copy to .env on the target machine and fill in. .env is gitignored and must
# stay that way (contract §6). Nothing in this file is read at build time; it
# is interpolated into compose.yaml at `docker compose up`.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# Most of this stack's secrets are NOT here — they are entered in each app's
# web UI after first start. See NOTES.md § "Secrets you supply by hand".


# ---------------------------------------------------------------------------
# Bind addresses — contract §5.2.
#
# THE ONE THING TO UNDERSTAND HERE:
#
# Docker publishes ports by DNAT in iptables' PREROUTING chain. The destination
# address is rewritten to the container *before* the packet reaches INPUT,
# which is where the host firewall lives. So a firewall rule naming a
# Docker-published port is not wrong — it is never consulted. It will pass
# review, pass a grep of the ruleset, and constrain nothing.
#
# For anything Docker publishes, THE BIND ADDRESS IS THE ONLY ENFORCEMENT.
#
# The rule that follows is the whole model:
#
#   No published port ever binds 0.0.0.0 — not even a service that is supposed
#   to be LAN-reachable. "Publish broadly, narrow with a firewall rule" is
#   precisely the mistake this section exists to prevent.
#
# The host firewall is still real and load-bearing — but only for services
# Docker does not publish: SSH, and Jellyfin on host networking. There is
# deliberately no firewall rule for any Docker-published port, because an inert
# rule that reads as protection is worse than no rule at all.


# BIND_ADDR_LAN — the bind address for all seven published services.
#
# Set to this machine's DHCP-reserved LAN address, e.g. 192.168.1.20.
#
# Everything is LAN-only, admin UIs included. There is no VPN in this design:
# contract v4 removed Tailscale because the family member this server exists
# for watches on a Roku, which has no VPN client, so a tailnet-based access
# model served nobody. Remote access is contract §5.3 — 443/tcp forwarded to a
# host-side TLS reverse proxy — and is not configured in this file.
#
# THIS VARIABLE HAS NO DEFAULT, DELIBERATELY. Leaving it blank does not start a
# degraded stack — compose aborts before starting anything:
#
#     error while interpolating services.prowlarr.ports.[]:
#     required variable BIND_ADDR_LAN is missing a value: no default — set to
#     this machine's LAN address in .env, contract §5.2
#
# That is designed behaviour, not a bug.
#
# It is enforced with compose's `${VAR:?message}` form, which is the construct
# that actually aborts. Do NOT rewrite it as a bare `${BIND_ADDR_LAN}` on the
# assumption that an empty value is rejected on its own. It is not — verified:
# compose emits a warning, exits 0, and renders the mapping with no host
# address at all, which binds every interface. That is precisely the failure
# this variable exists to prevent, arrived at silently.
BIND_ADDR_LAN=


# ---------------------------------------------------------------------------
# DOCKER_SUBNET — the stack's bridge network.
#
# Pinned so gluetun's killswitch can be told which subnet to let replies out
# to. Change only if it collides with something on your LAN; if you
# change it, this one value feeds both the network definition and gluetun.
DOCKER_SUBNET=172.28.0.0/16


# ---------------------------------------------------------------------------
# COMPOSE_PROFILES — the torrent path, off by default.
#
# This deployment is usenet-only. gluetun and qbittorrent are defined in
# compose.yaml but carry `profiles: ["torrents"]`, so they do not start and
# port 8080 does not listen. Seven services run, not nine.
#
# To turn torrents on: fill the VPN block below, then uncomment the next line
# and restart the stack. Nothing in palimpsest-system changes — the systemd
# unit's plain `docker compose up -d` reads this variable from here.
#
# BEFORE YOU DO: re-pin the gluetun and qbittorrent image tags in compose.yaml.
# They were resolved 2026-08-03 and rot while the profile is off; gluetun has
# renamed provider variables across versions, so the block below may no longer
# be correct for whatever version you end up pulling.
#
# COMPOSE_PROFILES=torrents


# ---------------------------------------------------------------------------
# VPN — gluetun, wrapping qBittorrent only.
#
# LEAVE ALL OF THIS BLANK unless you have enabled COMPOSE_PROFILES=torrents
# above. Nothing reads it otherwise, and a usenet-only stack needs no VPN:
# the connection to your provider is already TLS to a paid account in your name.
#
# Where these come from: your VPN provider's WireGuard config download. You
# generate or download a config file and copy the fields out of it; you do not
# use your account username/password for WireGuard.
#
# VPN_SERVICE_PROVIDER must be a name gluetun recognises — it is a fixed
# vocabulary, not free text. The list is at:
#   https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# and includes mullvad, protonvpn, airvpn, ivpn, windscribe, nordvpn,
# privateinternetaccess, surfshark, and ~40 others. Use `custom` with
# VPN_ENDPOINT_IP/VPN_ENDPOINT_PORT if yours is not supported.
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard

# WireGuard (VPN_TYPE=wireguard). From the provider's generated config:
#   [Interface] PrivateKey  -> WIREGUARD_PRIVATE_KEY
#   [Interface] Address     -> WIREGUARD_ADDRESSES   (e.g. 10.64.0.2/32)
#   [Peer]      PresharedKey-> WIREGUARD_PRESHARED_KEY   (blank if absent)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PRESHARED_KEY=

# OpenVPN (VPN_TYPE=openvpn). Leave blank if using WireGuard. These ARE the
# provider account credentials, unlike the WireGuard fields above.
OPENVPN_USER=
OPENVPN_PASSWORD=

# Optional: restrict exit servers. Comma-separated, provider's own spelling,
# e.g. "Netherlands,Sweden". Blank means gluetun picks any server.
SERVER_COUNTRIES=
