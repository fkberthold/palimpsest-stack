# palimpsest-stack — environment
#
# Copy to .env on the target machine and fill in. .env is gitignored and must
# stay that way (contract §6). Nothing in this file is read at build time; it
# is interpolated into compose.yaml at `docker compose up`.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# Most of this stack's secrets are NOT here — they are entered in each app's
# web UI after first start. See NOTES.md § "Secrets you supply by hand".


# ---------------------------------------------------------------------------
# Bind addresses — contract §5.2.
#
# WHY THERE ARE TWO OF THESE, AND WHY THEY MUST NOT BE COLLAPSED INTO ONE:
#
# Docker publishes ports by DNAT in iptables' PREROUTING chain. That traffic
# never traverses the INPUT chain, which is where the NixOS firewall lives. A
# container published on 0.0.0.0 is therefore reachable from the LAN no matter
# what the host firewall says — the firewall rule is not wrong, it is simply
# never consulted. The host firewall is still required as a second layer, and
# it is the *only* layer protecting Jellyfin (host-networked, so Docker does
# not publish it at all). But for published containers it cannot be the only
# layer, so this layer controls exposure by binding the publish address.
#
# Contract §5.1 does not apply one exposure policy to every service, so one
# variable cannot express it. There are two classes, and they are enforced by
# two different mechanisms:
#
#   Tailnet-only admin UIs   -> BIND_ADDR_TAILNET   enforced by the bind address
#   LAN + tailnet (Jellyseerr) -> BIND_ADDR_LAN     enforced by the firewall
#
# If you set them to the same value you have either exposed the admin UIs to
# the LAN or cut the family off from Jellyseerr. Neither failure is loud.


# BIND_ADDR_TAILNET — Bazarr, Prowlarr, Radarr, SABnzbd, Sonarr, qBittorrent.
#
# Set to this machine's tailnet address: `tailscale ip -4`, e.g. 100.x.y.z.
# Binding here is the primary enforcement — a socket bound to the tailnet
# address is simply not listening on the LAN, firewall or no firewall.
#
# Defaults to 127.0.0.1 so an unconfigured stack fails closed. Until you set
# it, reach the UIs over an SSH tunnel:
#     ssh -L 9696:127.0.0.1:9696 palimpsest
#
# Ordering consequence: Docker cannot bind an address that does not exist yet,
# so the stack unit must wait for tailscale0 to have an IPv4 address. That is a
# start precondition in palimpsest-system, not just an After= (contract §3).
BIND_ADDR_TAILNET=127.0.0.1

# BIND_ADDR_LAN — Jellyseerr only.
#
# Jellyseerr is LAN-reachable on purpose (contract §5.1): it is the family-
# facing request UI, and confining it to the tailnet would put it out of reach
# of the people it exists for. So this one is published broadly and its
# exposure is bounded by the host firewall's source rules (RFC1918 only)
# instead of by the bind address.
#
# 0.0.0.0 is the correct default here and is not an oversight. Leave it unless
# you are deliberately narrowing Jellyseerr to a single interface.
BIND_ADDR_LAN=0.0.0.0


# ---------------------------------------------------------------------------
# DOCKER_SUBNET — the stack's bridge network.
#
# Pinned so gluetun's killswitch can be told which subnet to let replies out
# to. Change only if it collides with something on your LAN or tailnet; if you
# change it, this one value feeds both the network definition and gluetun.
DOCKER_SUBNET=172.28.0.0/16


# ---------------------------------------------------------------------------
# VPN — gluetun, wrapping qBittorrent only.
#
# Where these come from: your VPN provider's WireGuard config download. You
# generate or download a config file and copy the fields out of it; you do not
# use your account username/password for WireGuard.
#
# VPN_SERVICE_PROVIDER must be a name gluetun recognises — it is a fixed
# vocabulary, not free text. The list is at:
#   https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# and includes mullvad, protonvpn, airvpn, ivpn, windscribe, nordvpn,
# privateinternetaccess, surfshark, and ~40 others. Use `custom` with
# VPN_ENDPOINT_IP/VPN_ENDPOINT_PORT if yours is not supported.
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard

# WireGuard (VPN_TYPE=wireguard). From the provider's generated config:
#   [Interface] PrivateKey  -> WIREGUARD_PRIVATE_KEY
#   [Interface] Address     -> WIREGUARD_ADDRESSES   (e.g. 10.64.0.2/32)
#   [Peer]      PresharedKey-> WIREGUARD_PRESHARED_KEY   (blank if absent)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PRESHARED_KEY=

# OpenVPN (VPN_TYPE=openvpn). Leave blank if using WireGuard. These ARE the
# provider account credentials, unlike the WireGuard fields above.
OPENVPN_USER=
OPENVPN_PASSWORD=

# Optional: restrict exit servers. Comma-separated, provider's own spelling,
# e.g. "Netherlands,Sweden". Blank means gluetun picks any server.
SERVER_COUNTRIES=
